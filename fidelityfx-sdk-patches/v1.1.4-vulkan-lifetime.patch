+void publishCpuPresentCompletion(FrameinterpolationPresentInfo* presenter, uint64_t completedFrame) // BL5：调用方已经返回本批次全部queue submit/Present，包括无图像的失败分支。
+{ // BL5：复用SDK调度锁，保持完成计数与通知一致。
+    EnterCriticalSection(&presenter->scheduledFrameCriticalSection); // BL5：此锁仅保护POD调度状态，不跨vkQueuePresent持有。
+    if (completedFrame > presenter->cpuPresentsCompleted) presenter->cpuPresentsCompleted = completedFrame; // BL5：跳过的旧批次由后续完成值覆盖，计数永不倒退。
+    WakeAllConditionVariable(&presenter->cpuPresentCompletion); // BL5：唤醒生命周期等待者，不消耗帧通知事件。
+    LeaveCriticalSection(&presenter->scheduledFrameCriticalSection); // BL5：允许下一批次正常调度。
+} // BL5：不增加GPU信号或虚构实际Present次数。
+
+bool waitForCpuPresentCompletion(FrameinterpolationPresentInfo* presenter, uint64_t targetFrame) // BL5：仅用于已有waitForPresents生命周期边界。
+{ // BL5：先等待CPU的最后Present调用返回，再允许QueueWaitIdle/DeviceWaitIdle。
+    EnterCriticalSection(&presenter->scheduledFrameCriticalSection); // BL5：与发布方使用同一锁，避免丢失唤醒。
+    while (presenter->cpuPresentsCompleted < targetFrame) // BL5：谓词循环覆盖伪唤醒和较旧批次通知。
+    { // BL5：等待时原子释放调度锁，worker仍能取出/完成当前最后一批。
+        if (!SleepConditionVariableCS(&presenter->cpuPresentCompletion, &presenter->scheduledFrameCriticalSection, INFINITE)) // BL5：阻塞只发生在生命周期等待，无轮询/sleep或额外GPU提交。
+        { // BL5：系统等待错误不能冒充完成。
+            LeaveCriticalSection(&presenter->scheduledFrameCriticalSection); // BL5：失败也必须释放已重新取得的锁。
+            return false; // BL5：调用方不进入可能与worker并发的队列idle。
+        } // BL5：正常唤醒后继续核对完成值。
+    } // BL5：目标批次的所有CPU队列调用已返回。
+    LeaveCriticalSection(&presenter->scheduledFrameCriticalSection); // BL5：不将状态锁带入Vulkan阻塞等待。
+    return true; // BL5：没有提前终止worker或丢弃最后一帧。
